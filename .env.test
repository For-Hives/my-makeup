# Environment of the local test bench: the three containers of compose.test.yml.
#
# Versioned on purpose. Every value here is made up: these names, ports and passwords only
# open containers that are thrown away, on this machine, and hold no real data. Never put a
# real secret or a remote address in this file: the guard of the tests refuses them
# (tests/outils/garde-environnement.ts).
#
# Plain NAME=value lines only, no quote, no variable inside a value: the bench reads this file
# itself (tests/outils/banc.ts) and adds BANC_DECALAGE to every port written here.

# The run declares the strictest environment of the guard.
APP_ENV=test

# PostgreSQL of the bench. Port 5443: 5442 is the development database. The name ends with
# « _test », which the guard requires.
DATABASE_URI=postgres://banc:mot-de-passe-factice@127.0.0.1:5443/mymakeup_test

# Signs the sessions of the bench only. At least 32 characters, like a real one.
PAYLOAD_SECRET=secret-factice-du-banc-de-test-qui-ne-protege-rien

# The address the application is served from when it runs against the bench, and the only
# origin a session cookie is accepted from. Without a final slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Mail catcher: SMTP in, and the address its HTTP API answers on.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_URL=http://127.0.0.1:8025

# Object storage with the S3 API. The bucket is created when the container starts; its name
# ends with « -test », which the guard requires.
S3_ENDPOINT=http://127.0.0.1:9090
S3_BUCKET=mymakeup-test
