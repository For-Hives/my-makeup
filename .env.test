# Environment of the local test bench: the four containers of compose.test.yml.
#
# Versioned on purpose. Every value here is made up: these names, ports and passwords only
# open containers that are thrown away, on this machine, and hold no real data. Never put a
# real secret or a remote address in this file: the guard of the tests refuses them
# (tests/outils/garde-environnement.ts).
#
# Plain NAME=value lines only, no quote, no variable inside a value: the bench reads this file
# itself (tests/outils/banc.ts) and adds BANC_DECALAGE to every port written here.

# The run declares the strictest environment of the guard.
APP_ENV=test

# PostgreSQL of the bench. Port 5443: 5442 is the development database. The name ends with
# « _test », which the guard requires.
DATABASE_URI=postgres://banc:mot-de-passe-factice@127.0.0.1:5443/mymakeup_test

# Signs the sessions of the bench only. At least 32 characters, like a real one.
PAYLOAD_SECRET=secret-factice-du-banc-de-test-qui-ne-protege-rien

# The address the application is served from when it runs against the bench, and the only
# origin a session cookie is accepted from. Without a final slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Mail catcher: SMTP in, and the address its HTTP API answers on. The application sends through
# SMTP_HOST and SMTP_PORT, so every mail of the bench lands in the catcher.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_URL=http://127.0.0.1:8025

# The sender of the mails of the bench, on a domain reserved for tests: the guard refuses the
# real sending domain here.
EMAIL_FROM=My Makeup <ne-pas-repondre@example.test>

# The fake Strapi source the import reads (docs/tests/source-strapi.md): a database of its own on
# the PostgreSQL of the bench, opened by a role that can only read it. Created by
# `bun run banc:source`. The name ends with « _test », which the guard requires.
STRAPI_SOURCE_URI=postgres://lecture_strapi:mot-de-passe-factice-de-lecture@127.0.0.1:5443/strapi_source_test

# Object storage with the S3 API. The bucket is created when the container starts; its name
# ends with « -test », which the guard requires.
S3_ENDPOINT=http://127.0.0.1:9090
S3_BUCKET=mymakeup-test

# The key the application signs its requests to the storage with. The simulator of the bench
# accepts any key: these two are made up, and say so.
S3_ACCESS_KEY_ID=cle-factice-du-banc
S3_SECRET_ACCESS_KEY=secret-factice-du-banc-de-test

# The fake Google of the bench: an OpenID Connect provider that stands in for Google, with
# made-up identities only. The application is pointed at it by GOOGLE_OIDC_ISSUER. The client
# and its secret are made up, and say so: the fake provider accepts these two and nothing else,
# and the guard refuses any value here that does not hold the word « factice ».
GOOGLE_OIDC_ISSUER=http://127.0.0.1:7080
GOOGLE_CLIENT_ID=client-google-factice-du-banc
GOOGLE_CLIENT_SECRET=secret-google-factice-du-banc-de-test

# The fake Umami of the bench (docs/tests/banc.md): an instance that stands in for the real one,
# made-up and thrown away. The application relays its audience measure (/u) to it, pointed at it
# by UMAMI_ORIGIN, and the guard refuses any other instance here. The domains Umami counts on are
# those of the bench, read when the pages are built.
UMAMI_ORIGIN=http://127.0.0.1:4200
NEXT_PUBLIC_UMAMI_DOMAINS=localhost,127.0.0.1

# The fake list of the communes of the bench (docs/tests/banc.md): it answers the two questions the
# space of the makeup artist asks geo.api.gouv.fr, from a few communes of the official list. The
# application of the end-to-end tests and of « banc:complet » is pointed at it by COMMUNES_DU_BANC
# (tests/outils/e2e.ts); the integration tests keep simulating the official list itself.
FAUSSES_COMMUNES=http://127.0.0.1:2050

# The key of IndexNow (ticket 219), made up: the site serves it at /<key>.txt, as the table of the
# frozen addresses promises (the parity test I45 asks it). Nothing is ever sent from the bench: the
# sending needs the address of the site and an environment other than « test » (cleSiLEnvoiEstPermis).
INDEXNOW_KEY=0123456789abcdef0123456789abcdef
