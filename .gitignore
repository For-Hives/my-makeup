# dependencies
/node_modules

# one lockfile only: bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# next.js
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# environment: real values are never committed, only the empty example is
.env
.env.*
!.env.exemple
# the environment of the local test bench: made-up values only, read by the tests
!.env.test

# migration working files (dumps, snapshots): local only
/.migration/

# tests
/coverage/
/playwright-report/
/test-results/

# logs
*.log

# misc
.DS_Store
*.pem
.idea

# sessions of the test bench, written by `bun run banc:session`
/.banc/
