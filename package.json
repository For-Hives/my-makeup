{
	"name": "my-makeup",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint . --error-on-warnings",
		"check": "biome check . --error-on-warnings",
		"check:write": "biome check --write . --error-on-warnings",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/unit/*.test.mjs\"",
		"test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/auth/run.mjs",
		"test:regression": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/regression/run.mjs",
		"precommit": "lint-staged",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,html}": "biome check --write --error-on-warnings --no-errors-on-unmatched"
	},
	"dependencies": {
		"@headlessui/react": "2.2.10",
		"@heroicons/react": "2.2.0",
		"@hookform/resolvers": "3.10.0",
		"@tailwindcss/typography": "0.5.19",
		"domhandler": "5.0.3",
		"form-data": "4.0.6",
		"html-react-parser": "5.2.17",
		"lodash": "4.18.1",
		"mailgun.js": "11.1.0",
		"material-icons": "1.13.14",
		"next": "15.5.27",
		"next-auth": "4.24.15",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "7.81.0",
		"react-toastify": "11.1.0",
		"remark": "15.0.1",
		"remark-html": "16.0.1",
		"remark-parse": "11.0.0",
		"sharp": "0.35.5",
		"swiper": "12.1.2",
		"to-vfile": "8.0.0",
		"unified": "11.0.5",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@playwright/test": "1.59.1",
		"@tailwindcss/forms": "0.5.11",
		"autoprefixer": "10.5.4",
		"domutils": "3.2.2",
		"htmlparser2": "10.1.0",
		"husky": "9.1.7",
		"lint-staged": "15.5.2",
		"postcss": "8.5.26",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"x2js": "3.4.4",
		"yaml": "2.9.1"
	}
}
