{
	"name": "my-makeup",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev --hostname 127.0.0.1",
		"build": "next build",
		"start": "next start",
		"payload": "bun node_modules/payload/bin.js --disable-transpile",
		"payload:types": "bun node_modules/payload/bin.js generate:types --disable-transpile",
		"payload:importmap": "bun node_modules/payload/bin.js generate:importmap --disable-transpile",
		"payload:migrate": "bun node_modules/payload/bin.js migrate --disable-transpile",
		"payload:migrate:create": "bun node_modules/payload/bin.js migrate:create --disable-transpile",
		"lint": "biome lint . --max-diagnostics=200",
		"check": "biome check --write .",
		"ci:biome": "biome ci . --reporter=github",
		"ci:canari": "bun --no-env-file scripts/ci/canari.ts",
		"renovate:valide": "bun --no-env-file scripts/ci/renovate-valide.ts",
		"typecheck": "next typegen && tsc --noEmit",
		"test:unit": "bun --no-env-file test ./tests/unit",
		"test:ci-garde": "bun --no-env-file test ./tests/ci",
		"image:build": "docker build --tag my-makeup:local .",
		"image:controle": "bun --no-env-file scripts/image/controle.ts",
		"test": "bun run test:unit",
		"banc:up": "bun --no-env-file scripts/banc.ts up",
		"banc:down": "bun --no-env-file scripts/banc.ts down",
		"banc:prepare": "bun --no-env-file scripts/banc.ts prepare",
		"test:integration": "bun --no-env-file scripts/banc.ts test",
		"test:e2e": "bun --no-env-file scripts/e2e.ts",
		"sondes": "bun --no-env-file tests/sondes/sondes.ts"
	},
	"dependencies": {
		"@hookform/resolvers": "5.9.1",
		"@payloadcms/db-postgres": "3.90.2",
		"@payloadcms/email-nodemailer": "3.90.2",
		"@payloadcms/next": "3.90.2",
		"@payloadcms/storage-s3": "3.90.2",
		"@payloadcms/ui": "3.90.2",
		"fuse.js": "7.5.0",
		"graphql": "16.14.2",
		"next": "16.3.8",
		"payload": "3.90.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.89.0",
		"sharp": "0.35.5",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.4.11",
		"@playwright/test": "1.59.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/bun": "1.3.14",
		"@types/node": "24.19.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"jsdom": "30.1.2",
		"msw": "2.15.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3"
	},
	"overrides": {
		"dompurify": "3.4.17",
		"nodemailer": "10.0.15",
		"undici": "7.29.1"
	}
}
