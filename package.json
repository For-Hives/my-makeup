{
	"name": "my-makeup",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "next dev --hostname 127.0.0.1",
		"build": "next build",
		"start": "next start",
		"payload": "bun node_modules/payload/bin.js --disable-transpile",
		"payload:types": "bun node_modules/payload/bin.js generate:types --disable-transpile",
		"payload:importmap": "bun node_modules/payload/bin.js generate:importmap --disable-transpile",
		"payload:migrate": "bun node_modules/payload/bin.js migrate --disable-transpile",
		"payload:migrate:create": "bun node_modules/payload/bin.js migrate:create --disable-transpile",
		"lint": "biome lint . --max-diagnostics=200",
		"check": "biome check --write .",
		"ci:biome": "biome ci . --reporter=github",
		"ci:canary": "bun --no-env-file scripts/ci/canary.ts",
		"schema:drift": "bun --no-env-file scripts/ci/schema-drift.ts",
		"renovate:validate": "bun --no-env-file scripts/ci/renovate-validate.ts",
		"typecheck": "next typegen && tsc --noEmit",
		"test:unit": "bun --no-env-file test ./tests/unit",
		"test:ci-guard": "bun --no-env-file test ./tests/ci",
		"image:build": "docker build --tag my-makeup:local .",
		"image:check": "bun --no-env-file scripts/image/check.ts",
		"test": "bun run test:unit",
		"bench:up": "bun --no-env-file scripts/bench.ts up",
		"bench:down": "bun --no-env-file scripts/bench.ts down",
		"bench:prepare": "bun --no-env-file scripts/bench.ts prepare",
		"bench:source": "bun --no-env-file scripts/source-strapi.ts",
		"bench:import": "bun --no-env-file scripts/migration/bench-import.ts",
		"bench:reconcile": "bun --no-env-file scripts/media/reconciliation.ts",
		"media:backup": "bun --no-env-file scripts/media/backup.ts",
		"bench:full": "bun --no-env-file scripts/bench.ts full",
		"bench:reset": "bun --no-env-file scripts/bench.ts reset",
		"bench:session": "bun --no-env-file scripts/bench.ts session",
		"migration:import": "bun --no-env-file scripts/migration/import.ts",
		"rehearsal": "bun --no-env-file scripts/migration/rehearsal.ts",
		"migration:freeze": "bun --no-env-file scripts/migration/freeze.ts",
		"admin:create": "bun --no-env-file scripts/admin/create-admin.ts",
		"test:integration": "bun --no-env-file scripts/bench.ts test",
		"test:e2e": "bun --no-env-file scripts/e2e.ts",
		"probes": "bun --no-env-file tests/probes/probes.ts",
		"watch:site": "bun --no-env-file scripts/watch/run-watch.ts",
		"notes:add": "bun --no-env-file scripts/release/add-note.ts",
		"release:publish": "bun --no-env-file scripts/release/publication.ts",
		"cutover:check": "bun --no-env-file scripts/cutover/run-host-check.ts",
		"cutover:ui-crawl": "bun --no-env-file scripts/cutover/run-ui-crawl.ts",
		"indexnow:all": "bun --no-env-file scripts/seo/indexnow-all.ts",
		"names:check": "bun --no-env-file scripts/naming/check.ts",
		"perf:lighthouse": "bun --no-env-file scripts/perf/lighthouse.ts",
		"perf:ci": "bun --no-env-file scripts/perf/ci.ts",
		"perf:pool-load": "bun --no-env-file scripts/perf/pool-load.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1147.0",
		"@hookform/resolvers": "5.9.1",
		"@payloadcms/db-postgres": "3.90.2",
		"@payloadcms/email-nodemailer": "3.90.2",
		"@payloadcms/next": "3.90.2",
		"@payloadcms/storage-s3": "3.90.2",
		"@payloadcms/translations": "3.90.2",
		"@payloadcms/ui": "3.90.2",
		"bcryptjs": "3.0.3",
		"fuse.js": "7.5.0",
		"graphql": "16.14.2",
		"next": "16.3.8",
		"payload": "3.90.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.89.0",
		"rehype-sanitize": "6.0.0",
		"rehype-stringify": "10.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"sharp": "0.35.5",
		"unified": "11.0.5",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.4.11",
		"@playwright/test": "1.59.1",
		"@tailwindcss/postcss": "4.3.3",
		"@types/bun": "1.3.14",
		"@types/node": "24.19.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"jsdom": "30.1.2",
		"msw": "2.15.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3"
	},
	"overrides": {
		"dompurify": "3.4.17",
		"nodemailer": "10.0.15",
		"undici": "7.29.1"
	},
	"patchedDependencies": {
		"payload@3.90.2": "patches/payload@3.90.2.patch"
	}
}
