NEXTAUTH_SECRET="XXXX"
NEXT_PUBLIC_API_URL=https://api.my-makeup.fr
NEXT_PUBLIC_URL=https://my-makeup.fr
NEXT_PUBLIC_DATABASE_URL=postgres://XXX:XXXX@URL:PORT/DB?synchronize=true
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID="XXXX.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="XXXX"
FACEBOOK_CLIENT_ID="XXX"
FACEBOOK_CLIENT_SECRET="XXXX"
MAILGUN_API_KEY="XXX"
MAILGUN_API_URL="https://api.mailgun.net/v3/XXXX.mailgun.org"
MAILGUN_PUBLIC_KEY="XXXX"
MAILGUN_DOMAIN="XXXX.mailgun.org"
# "eu" sends through api.eu.mailgun.net (the domain must be in the EU region); unset keeps the US endpoint
MAILGUN_REGION=
# External quote form (F3a), https only. Empty: no "Demander un devis" button.
# Read on the server by the profile page and passed as a prop: set it at build time
# (Coolify "Build Variable") and redeploy; a runtime-only value shows up as profiles regenerate (ISR, 10 s).
NEXT_PUBLIC_DEVIS_FORM_URL=
# Version shown by /api/health (short sha); falls back to SOURCE_COMMIT, then package.json
NEXT_PUBLIC_APP_VERSION=
