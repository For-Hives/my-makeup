# Required at runtime in production: the server refuses to start without it (openssl rand -base64 32)
NEXTAUTH_SECRET="XXXX"
NEXT_PUBLIC_API_URL=https://api.my-makeup.fr
# Origin of the site (with or without trailing slash): canonical, sitemap, robots.txt, Open Graph
# and JSON-LD start from it. Read at build time (Coolify "Build Variable").
NEXT_PUBLIC_URL=https://my-makeup.fr
NEXTAUTH_URL=http://localhost:3000
# Strapi as seen from the Next server (Docker network, e.g. http://<api-container>:1337).
# Used by NextAuth and the private pages; empty: NEXT_PUBLIC_API_URL. Runtime variable.
API_INTERNAL_URL=
# Max interval (ms) between two checks of the Strapi JWT per session (/api/users/me).
# Empty: 900000 (15 min). 0 checks on every session read (tests only).
AUTH_REVALIDATION_MS=
GOOGLE_CLIENT_ID="XXXX.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="XXXX"
MAILGUN_API_KEY="XXX"
MAILGUN_API_URL="https://api.mailgun.net/v3/XXXX.mailgun.org"
MAILGUN_PUBLIC_KEY="XXXX"
MAILGUN_DOMAIN="XXXX.mailgun.org"
# "eu" sends through api.eu.mailgun.net (the domain must be in the EU region); unset keeps the US endpoint
MAILGUN_REGION=
# External quote form (F3a), https only. Empty: no "Demander un devis" button.
# Read on the server by the profile page and passed as a prop: set it at build time
# (Coolify "Build Variable") and redeploy; a runtime-only value shows up as profiles regenerate (ISR, 10 s).
NEXT_PUBLIC_DEVIS_FORM_URL=
# Version shown by /api/health and sent as the data-tag of every Umami event (short sha);
# falls back to SOURCE_COMMIT given to the build (Coolify « Include Source Commit in Build »),
# then package.json. Read at build time.
NEXT_PUBLIC_APP_VERSION=
# Umami instance the site proxies under /u/script.js and /u/api/send (MES-10), origin only
# (e.g. https://umami.example.org). Empty: https://umami.wadefade.fr. Read at build time:
# Coolify "Build Variable", then redeploy (a restart keeps the old rewrites).
UMAMI_ORIGIN=
# Hostnames Umami counts visits on, comma separated. Empty: my-makeup.fr,www.my-makeup.fr
# (a local build or a copy of the site sends nothing). Read at build time.
NEXT_PUBLIC_UMAMI_DOMAINS=
# "on" shows « Mot de passe oublié ? » on the sign-in page and opens /auth/mot-de-passe-oublie (A7).
# Turn it on only once Strapi sends emails (Mailgun configured, reset URL set in the admin).
# Read at build time: Coolify "Build Variable", then redeploy.
NEXT_PUBLIC_FORGOT_PASSWORD=
